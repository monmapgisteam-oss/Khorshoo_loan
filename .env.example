# ArcGIS Online нэвтрэлт (заавал биш).
# Хоосон бол апп нэвтрэлтгүй, нээлттэй ажиллана.
# Утга тавибал ArcGIS developer credentials (OAuth 2.0)-ийн Client ID-г бичнэ;
# тухайн credentials-ийн Redirect URL-д аппын хаяг (жишээ нь
# https://khorshoo-loan.vercel.app ба http://localhost:3000) бүртгэгдсэн байх ёстой.
NEXT_PUBLIC_ARCGIS_CLIENT_ID=

# ArcGIS Enterprise portal ашиглах бол (анхдагч: https://www.arcgis.com)
# NEXT_PUBLIC_ARCGIS_PORTAL_URL=https://www.arcgis.com
